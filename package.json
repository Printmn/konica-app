    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
